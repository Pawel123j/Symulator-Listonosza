<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless regression harness for the day-loop logic. It compiles the REAL game sources from
    Assets/_Project/Scripts against a minimal stand-in of the Unity API (UnityStubs.cs), so the
    lifecycle (Awake, OnEnable, Start, Update, OnDestroy), PlayerPrefs and input callbacks are local
    adapters. Run with: dotnet run with project tools/LogicTests; exit code 0 means all checks passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0414;CS0649;CS0169</NoWarn>
    <Scripts>../../Assets/_Project/Scripts</Scripts>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="BuildManifestCheck.cs" />
    <Compile Include="$(Scripts)/Core/*.cs" />
    <Compile Include="$(Scripts)/Data/*.cs" />
    <Compile Include="$(Scripts)/Grid/GridConfig.cs" />
    <Compile Include="$(Scripts)/Grid/GridSystem.cs" />
    <Compile Include="$(Scripts)/Gameplay/GameLoopManager.cs" />
    <Compile Include="$(Scripts)/Gameplay/DeliveryService.cs" />
    <Compile Include="$(Scripts)/Gameplay/PlayerInventory.cs" />
    <Compile Include="$(Scripts)/Gameplay/DeliveryPickupPoint.cs" />
    <Compile Include="$(Scripts)/Gameplay/DeliveryTarget.cs" />
    <Compile Include="$(Scripts)/Gameplay/IInteractable.cs" />
    <Compile Include="$(Scripts)/Gameplay/InteractableRegistry.cs" />
    <Compile Include="$(Scripts)/Gameplay/MobileInput.cs" />
    <Compile Include="$(Scripts)/Gameplay/DeliveryFeedback.cs" />
  </ItemGroup>
</Project>
